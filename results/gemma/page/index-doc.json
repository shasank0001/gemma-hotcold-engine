{"text": "<meta name=\"dash-one-writer\">\n<style>\n.gb { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n.gb h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.gb h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.gb p { margin: 0; }\n.gb-lead { color: var(--color-fg-muted); max-width: 65ch; }\n.gb-tiles, .gb-charts { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }\n.gb-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); min-width: 0; align-content: start; }\n.gb-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; }\n.gb-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.gb-chart { position: relative; min-height: 280px; }\n.gb-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.gb-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n.gb-legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }\n.gb-table { overflow-x: auto; }\n.gb-table table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-body); font-variant-numeric: tabular-nums; }\n.gb-table th, .gb-table td { text-align: left; padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n.gb-table th { font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.gb-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n</style>\n<div class=\"gb\">\n  <header id=\"top\" style=\"display:grid;gap:var(--cds-gap-sm)\">\n    <h1>Gemma 4 26B runs faster on an 8 GB laptop GPU</h1>\n    <p class=\"gb-lead\">The engine keeps often-used experts on the GPU, runs the rest on the CPU, and never makes decode wait for an upload. It beat the best stock llama.cpp setting at every VRAM level tested, on both workloads. Every engine here uses multi-token prediction.</p>\n  </header>\n  <div class=\"gb-tiles\">\n    <div class=\"gb-card\">\n      <div class=\"gb-note\">Mixed prompts at 5.9 GB, against best stock</div>\n      <div class=\"gb-big\"><span data-draw=\"mixedgain\" data-source=\"gains\" data-field=\"gain_pct\" data-where=\"workload=Mixed&amp;vram_gb=5.9\">\u2014</span>%</div>\n      <div class=\"gb-note\"><span data-draw=\"mixedengine\" data-source=\"gains\" data-field=\"engine_tps\" data-where=\"workload=Mixed&amp;vram_gb=5.9\">\u2014</span> tok/s against <span data-draw=\"mixedstock\" data-source=\"gains\" data-field=\"stock_tps\" data-where=\"workload=Mixed&amp;vram_gb=5.9\">\u2014</span> tok/s. Prompts were held out of the profile.</div>\n    </div>\n    <div class=\"gb-card\">\n      <div class=\"gb-note\">Unseen math prompts at 5.9 GB, against best stock</div>\n      <div class=\"gb-big\"><span data-draw=\"mathgain\" data-source=\"gains\" data-field=\"gain_pct\" data-where=\"workload=Math&amp;vram_gb=5.9\">\u2014</span>%</div>\n      <div class=\"gb-note\"><span data-draw=\"mathengine\" data-source=\"gains\" data-field=\"engine_tps\" data-where=\"workload=Math&amp;vram_gb=5.9\">\u2014</span> tok/s against <span data-draw=\"mathstock\" data-source=\"gains\" data-field=\"stock_tps\" data-where=\"workload=Math&amp;vram_gb=5.9\">\u2014</span> tok/s. The hot set adapted while running.</div>\n    </div>\n  </div>\n  <section id=\"speed\" style=\"display:grid;gap:var(--cds-gap-md)\">\n    <h2>Decode speed at each VRAM budget</h2>\n    <div class=\"gb-legend\">\n      <span><i data-swatch=\"0\"></i>This engine</span>\n      <span><i data-swatch=\"1\"></i>Stock layer split</span>\n      <span><i data-swatch=\"2\"></i>Stock cache</span>\n    </div>\n    <div class=\"gb-charts\">\n      <div class=\"gb-card\"><h2>Mixed prompts</h2><p class=\"gb-note\">Held-out code, chat and reasoning prompts. Mean of 3 cold starts.</p><div class=\"gb-chart\" data-draw=\"chartmixed\" data-source=\"matrix\"></div></div>\n      <div class=\"gb-card\"><h2>Math prompts</h2><p class=\"gb-note\">A workload the starting hot list never saw. Mean of 3 cold starts.</p><div class=\"gb-chart\" data-draw=\"chartmath\" data-source=\"matrix\"></div></div>\n    </div>\n  </section>\n  <section id=\"gains\" class=\"gb-card\">\n    <h2>Gain over the best stock setting at or below each VRAM level</h2>\n    <div class=\"gb-table\"><table data-source=\"gains\" data-row-key=\"workload,vram_gb\">\n      <thead><tr><th data-field=\"workload\">Workload</th><th data-field=\"vram_gb\">VRAM (GB)</th><th data-field=\"stock_setting\">Best stock setting</th><th data-field=\"stock_tps\">Stock tok/s</th><th data-field=\"engine_tps\">Engine tok/s</th><th data-field=\"gain_pct\">Gain %</th></tr></thead>\n      <tbody data-draw=\"gainrows\"></tbody>\n    </table></div>\n  </section>\n  <section id=\"checks\" class=\"gb-card\">\n    <h2>What was checked and where it stops</h2>\n    <div class=\"gb-table\"><table data-source=\"checks\" data-row-key=\"check\">\n      <thead><tr><th data-field=\"check\">Check</th><th data-field=\"result\">Result</th><th data-field=\"note\">Detail</th></tr></thead>\n      <tbody data-draw=\"checkrows\"></tbody>\n    </table></div>\n  </section>\n</div>\n<script>\nconst SERIES = ['This engine', 'Stock layer split', 'Stock cache'];\ndocument.querySelectorAll('[data-swatch]').forEach((el) => { el.style.background = dash.colors[+el.dataset.swatch]; });\n\ndash.calc('gains', {\n  inputs: ['matrix'],\n  title: 'Gain over best stock',\n  description: 'For each engine run, the fastest stock setting that used no more VRAM on the same workload.',\n  fn: (matrix) => {\n    const rows = matrix.map((r) => ({...r, vram_mib: +r.vram_mib, decode_tps: +r.decode_tps}));\n    return rows.filter((r) => r.engine === 'This engine').map((e) => {\n      const stock = rows.filter((r) => r.workload === e.workload && r.engine !== 'This engine' && r.vram_mib <= e.vram_mib).sort((a, b) => b.decode_tps - a.decode_tps)[0];\n      return {workload: e.workload, vram_gb: (e.vram_mib / 1000).toFixed(1), stock_setting: stock.setting, stock_tps: stock.decode_tps, engine_tps: e.decode_tps, gain_pct: Math.round(100 * (e.decode_tps / stock.decode_tps - 1))};\n    }).sort((a, b) => a.workload.localeCompare(b.workload) || a.vram_gb - b.vram_gb);\n  },\n});\n\nconst cell = (name, workload, field, fmt) => dash.draw(name, (el) => {\n  const g = dash.data('gains');\n  const r = g.status === 'ok' ? g.data.find((x) => x.workload === workload && x.vram_gb === '5.9') : null;\n  el.textContent = r ? fmt(r[field]) : '\u2014';\n});\nconst plus = (v) => '+' + v;\nconst one = (v) => v.toFixed(1);\ncell('mixedgain', 'Mixed', 'gain_pct', plus); cell('mixedengine', 'Mixed', 'engine_tps', one); cell('mixedstock', 'Mixed', 'stock_tps', one);\ncell('mathgain', 'Math', 'gain_pct', plus); cell('mathengine', 'Math', 'engine_tps', one); cell('mathstock', 'Math', 'stock_tps', one);\n\nconst chart = (name, workload) => dash.draw(name, (el) => {\n  const m = dash.data('matrix');\n  el.replaceChildren();\n  if (m.status !== 'ok') { el.textContent = '\u2014'; return; }\n  const rows = m.data.filter((r) => r.workload === workload).map((r) => ({engine: r.engine, setting: r.setting, x: +r.vram_mib / 1000, y: +r.decode_tps}));\n  const W = Math.max(el.clientWidth, 280), H = 280, M = {t: 12, r: 16, b: 40, l: 40};\n  const x = d3.scaleLinear([4, 8], [M.l, W - M.r]);\n  const y = d3.scaleLinear([0, 130], [H - M.b, M.t]);\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', `Decode speed by VRAM, ${workload} prompts`);\n  const gy = svg.append('g').attr('transform', `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(6).tickSize(-(W - M.l - M.r))).attr('font-size', null).attr('font-family', null);\n  gy.select('.domain').remove();\n  gy.selectAll('line').style('stroke', 'var(--cds-chart-grid)');\n  const gx = svg.append('g').attr('transform', `translate(0,${H - M.b})`).call(d3.axisBottom(x).ticks(4).tickFormat((d) => d + ' GB')).attr('font-size', null).attr('font-family', null);\n  gx.select('.domain').style('stroke', 'var(--cds-chart-axis)');\n  gx.selectAll('line').remove();\n  svg.selectAll('text').style('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n  svg.append('text').attr('x', M.l).attr('y', H - 6).text('VRAM used. Vertical axis is tok/s.').style('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n  const line = d3.line().x((d) => x(d.x)).y((d) => y(d.y));\n  const tip = d3.select(el).append('div').attr('class', 'gb-tip').attr('hidden', true);\n  SERIES.forEach((s, i) => {\n    const pts = rows.filter((r) => r.engine === s).sort((a, b) => a.x - b.x);\n    svg.append('path').attr('d', line(pts)).attr('fill', 'none').attr('stroke', dash.colors[i]).attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round');\n    svg.append('g').selectAll('circle').data(pts).join('circle').attr('cx', (d) => x(d.x)).attr('cy', (d) => y(d.y)).attr('r', 4).attr('fill', dash.colors[i]).attr('stroke', 'var(--color-panel)').attr('stroke-width', 2);\n    svg.append('g').selectAll('circle').data(pts).join('circle').attr('cx', (d) => x(d.x)).attr('cy', (d) => y(d.y)).attr('r', 14).attr('fill', 'transparent')\n      .on('pointerenter', (ev, d) => {\n        tip.attr('hidden', null).text(`${s}, ${d.setting}: ${d.y.toFixed(1)} tok/s at ${d.x.toFixed(1)} GB`);\n        const tw = tip.node().offsetWidth;\n        tip.style('left', Math.max(0, Math.min(x(d.x) - tw / 2, el.clientWidth - tw)) + 'px').style('top', Math.max(0, y(d.y) * el.clientWidth / W - 34) + 'px');\n      })\n      .on('pointerleave', () => tip.attr('hidden', true));\n  });\n});\nchart('chartmixed', 'Mixed');\nchart('chartmath', 'Math');\n\nconst fill = (name, id, cols) => dash.draw(name, (el) => {\n  const g = dash.data(id);\n  el.replaceChildren();\n  (g.status === 'ok' ? g.data : []).forEach((r) => {\n    const tr = el.insertRow();\n    cols.forEach((c) => { tr.insertCell().textContent = r[c]; });\n  });\n});\nfill('gainrows', 'gains', ['workload', 'vram_gb', 'stock_setting', 'stock_tps', 'engine_tps', 'gain_pct']);\nfill('checkrows', 'checks', ['check', 'result', 'note']);\n</script>\n"}